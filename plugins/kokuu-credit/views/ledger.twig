{#
  积分流水（管理后台）

  【2026-11-03 重做】用户反馈：「这个积分流水的页面我现在感觉不合理，
  没有查询，只是一直在排，很不好用」

  旧版问题：
    · 只有一个折叠的「按用户筛选」UID 输入框
    · 列表固定拉 50 条，无分页
    · 无法按来源/时间/关键词定位

  新版：
    · 顶部一排查询条件：关键词、来源、日期范围
    · 查询栏常驻展开（这是管理工具的首要操作，不该藏起来）
    · 分页：显示总数 / 页码 / 上一页下一页
    · 「重置」一键清空条件

  数据由以下接口提供：
    GET /plugin/kokuu-credit/api/ledger
        ?q=&source=&uid=&from=&to=&page=&per=
    GET /plugin/kokuu-credit/api/ledger/sources   （筛选下拉的选项）

  调分面板仍保留在最上方（低频操作，默认收起）。
#}
{% extends 'user.base.twig' %}

{% block content %}
<div class="container kcPage"
     data-users-url="{{ url('/plugin/kokuu-credit/api/users') }}"
     data-adjust-url="{{ url('/plugin/kokuu-credit/api/adjust') }}"
     data-sources-url="{{ url('/plugin/kokuu-credit/api/ledger/sources') }}">

  {# ---- 管理员调分面板（默认收起） ---- #}
  <details class="kcPage-tools kcAdj" id="kc-adj">
    <summary class="kcPage-tools-sum">
      <i class="fas fa-sliders-h"></i>
      调整用户积分
    </summary>
    <div class="kcPage-tools-body">
      <p class="help-text">
        余额改动<strong>一定</strong>会写进下方流水（来源「管理员手动」），
        并记录操作人。扣分<strong>不受底仓限制</strong>，但不允许扣成负数。
      </p>

      <div class="kcAdj-row">
        <label class="kcPage-label" for="kc-adj-q">搜索用户</label>
        <input class="kcPage-input" type="text" id="kc-adj-q"
               placeholder="UID / 昵称 / 邮箱" autocomplete="off">
        <button class="kcPage-btn kcPage-btn--go" id="kc-adj-search" type="button">查找</button>
      </div>
      <div id="kc-adj-results" class="kcAdj-results" hidden></div>

      <div class="kcAdj-picked" id="kc-adj-picked" hidden>
        <div class="kcAdj-picked-name">
          <span id="kc-adj-picked-nickname"></span>
          <span class="kcRec-uid" id="kc-adj-picked-uid"></span>
        </div>
        <div class="kcAdj-picked-mail" id="kc-adj-picked-email"></div>
        <div class="kcAdj-picked-score">
          当前余额 <b id="kc-adj-picked-score">0</b>
        </div>
      </div>

      <div class="kcAdj-form" id="kc-adj-form" hidden>
        <div class="kcAdj-row">
          <label class="kcPage-label">操作</label>
          <div class="kcAdj-modes" id="kc-adj-modes">
            <label><input type="radio" name="kc-adj-mode" value="add" checked> 增加</label>
            <label><input type="radio" name="kc-adj-mode" value="sub"> 扣减</label>
            <label><input type="radio" name="kc-adj-mode" value="set"> 设为</label>
          </div>
        </div>
        <div class="kcAdj-row">
          <label class="kcPage-label" for="kc-adj-amount" id="kc-adj-amount-label">数额</label>
          <input class="kcPage-input" type="number" id="kc-adj-amount" min="0" step="1" value="0">
          <span class="kcAdj-preview" id="kc-adj-preview"></span>
        </div>
        <div class="kcAdj-row">
          <label class="kcPage-label" for="kc-adj-note">原因</label>
          <input class="kcPage-input" type="text" id="kc-adj-note"
                 maxlength="100" placeholder="写清楚原因，会记进流水">
        </div>
        <div class="kcAdj-row">
          <button class="kcPage-btn kcPage-btn--go" id="kc-adj-submit" type="button">确认调整</button>
          <span class="kcAdj-msg" id="kc-adj-msg"></span>
        </div>
      </div>
    </div>
  </details>

  {# ---- 页头 ---- #}
  <header class="kcPage-head">
    <div>
      <h2 class="kcPage-title">
        <i class="fas fa-coins"></i>
        积分流水
      </h2>
      <p class="kcPage-sub">
        所有积分变动记录。可按关键词、来源、时间筛选。
      </p>
    </div>
    <button id="kc-refresh" class="kcPage-btn" type="button">
      <i class="fas fa-rotate"></i>
      刷新
    </button>
  </header>

  {# ---- 概览数字 ---- #}
  <div class="kcPage-stats">
    <div class="kcPage-stat">
      <span class="kcPage-stat-num" id="kc-stat-total">{{ stats.total }}</span>
      <span class="kcPage-stat-label">累计笔数</span>
    </div>
    <div class="kcPage-stat">
      <span class="kcPage-stat-num" id="kc-stat-today">{{ stats.today }}</span>
      <span class="kcPage-stat-label">今日发放</span>
    </div>
    <div class="kcPage-stat">
      <span class="kcPage-stat-num" id="kc-stat-events">{{ stats.events }}</span>
      <span class="kcPage-stat-label">今日事件</span>
    </div>
  </div>

  {# ---- 查询栏（常驻，不折叠） ---- #}
  <form class="kcQuery" id="kc-query" autocomplete="off">
    <div class="kcQuery-row">
      <div class="kcQuery-field kcQuery-field--grow">
        <label class="kcPage-label" for="kc-q">关键词</label>
        <input class="kcPage-input" type="text" id="kc-q"
               placeholder="用户昵称 / 邮箱 / 事件ID / 备注">
      </div>

      <div class="kcQuery-field">
        <label class="kcPage-label" for="kc-source">来源</label>
        <select class="kcPage-input" id="kc-source">
          <option value="">全部来源</option>
        </select>
      </div>

      <div class="kcQuery-field">
        <label class="kcPage-label" for="kc-from">起始日期</label>
        <input class="kcPage-input" type="date" id="kc-from">
      </div>

      <div class="kcQuery-field">
        <label class="kcPage-label" for="kc-to">结束日期</label>
        <input class="kcPage-input" type="date" id="kc-to">
      </div>

      <div class="kcQuery-actions">
        <button class="kcPage-btn kcPage-btn--go" id="kc-search" type="submit">
          <i class="fas fa-magnifying-glass"></i> 查询
        </button>
        <button class="kcPage-btn" id="kc-reset" type="button">重置</button>
      </div>
    </div>
  </form>

  {# ---- 查询结果计数 ---- #}
  <div class="kcQuery-meta" id="kc-query-meta" hidden>
    共 <b id="kc-total">0</b> 条记录
  </div>

  {# ---- 列表 ---- #}
  <div id="kc-list" data-url="{{ url('/plugin/kokuu-credit/api/ledger') }}">
    <div class="kcPage-empty">加载中…</div>
  </div>

  {# ---- 分页 ---- #}
  <nav class="kcPager" id="kc-pager" hidden>
    <button class="kcPage-btn" id="kc-prev" type="button">上一页</button>
    <span class="kcPager-info" id="kc-pager-info"></span>
    <button class="kcPage-btn" id="kc-next" type="button">下一页</button>
  </nav>
</div>
{% endblock %}

