{#
  KokuuSkin 论坛聚合 —— 仪表盘卡片（widget）

  由内核仪表盘（/user）的 grid.twig 通过
  `{{ include('user.widgets.dashboard.forum') }}` 渲染。
  注册位置：bootstrap.php 里 `Filter::add('grid:user.index', ...)`。

  ⚠️ 路径说明：视图名 user.widgets.dashboard.forum 由Laravel 的
    view finder 解析，而 finder 的搜索路径里**没有插件目录**，
    所以 bootstrap.php 主动 `View::addLocation($plugin->getPath().'/views')`
    把插件 views/ 加进去，文件按命名约定放在
    views/user/widgets/dashboard/forum.twig。
    （不直接写进 resources/views/overrides：那目录是给站点级定制用的，
      插件文件放进去会随插件升级留下垃圾文件。）

  ⚠️ 数据来源：widget 走 include，拿不到控制器的 ->with([...])，
    必须在 bootstrap.php 里用 View::composer 往这个视图名上挂数据。
    此处能拿到的变量：kokuu_forum_cfg / kokuu_forum_data / kokuu_forum_i18n。

  ⚠️ 变量可能不存在：composer 挂的是 view 名而非文件路径，若 finder
    因为任何原因没解析到本文件，Twig 找不到模板会直接抛错。所以下面
    一律用 ?? 兜底，保证最坏情况是「空卡片」而不是整页 500。

  内核自带的 announcement（公告）卡片已被本插件接管并从 grid 中移除，
  改由配置页的「置顶帖子ID」实现同样的公告能力。
#}

{% set cfg = kokuu_forum_cfg ?? {} %}
{% set data = kokuu_forum_data ?? {ok: false, items: [], pinned: [], regular: [], message: null} %}
{% set i18n = kokuu_forum_i18n ?? {} %}

<div class="card card-primary card-outline kf-widget"
     id="kf-widget"
     data-endpoint="{{ url('plugin/kokuu-forum/api/threads') }}"
     data-forum="{{ cfg.forum_url ?? '' }}">

  <div class="card-header kf-widget-head">
    <h3 class="card-title">
      <i class="fas fa-comments kf-widget-icon"></i>
      {{ cfg.menu_title ?? i18n.subtitle ?? '社区' }}
      {% if data.items|default([])|length %}
        <span class="kf-widget-count">{{ data.items|length }}</span>
      {% endif %}
    </h3>

    {# 「前往论坛」整合进卡片：侧边栏不再放入口，这里是唯一的一键跳转 #}
    <div class="kf-widget-tools">
      <button type="button" class="kf-widget-btn" id="kf-widget-refresh"
              title="{{ i18n.refresh ?? '刷新' }}">
        <i class="fas fa-sync-alt"></i>
      </button>
      <a class="kf-widget-btn kf-widget-btn-primary"
         href="{{ cfg.forum_url ?? '#' }}" target="_blank" rel="noopener noreferrer">
        {{ i18n.forum ?? '前往论坛' }} <i class="fas fa-arrow-right"></i>
      </a>
    </div>
  </div>

  <div class="card-body kf-widget-body" id="kf-widget-list">

    {% if data.items|default([])|length %}

      {% if data.pinned|default([])|length %}
        {# ---- 置顶区：替代内核公告卡片 ---- #}
        <div class="kf-widget-section">
          <div class="kf-widget-label">
            <i class="fas fa-thumbtack"></i> {{ i18n.pinned ?? '置顶' }}
          </div>
          {% for it in data.pinned %}
            <div class="kf-row kf-row-pinned">
              <div class="kf-avatar" aria-hidden="true"
                   style="background: hsl({{ it.avatarColor }}, 58%, 56%);">
                {{ it.avatarInitial }}
              </div>
              <div class="kf-body">
                <a class="kf-row-title" href="{{ it.url }}" target="_blank"
                   rel="noopener noreferrer" title="{{ it.title }}">{{ it.title }}</a>
                <div class="kf-meta">
                  <span><i class="fas fa-user"></i>{{ it.author }}</span>
                  <span><i class="far fa-clock"></i>{{ it.lastPostedRel }}</span>
                </div>
              </div>
              <div class="kf-stat">
                <b>{{ it.comments }}</b>
                <small>{{ i18n.replies ?? '回复' }}</small>
              </div>

              {# 置顶帖同样显示评论摘要：公告帖下面大家的反馈往往才是重点。
                 text 已由 PHP 侧洗成纯文本，此处只做自动转义输出。 #}
              {% if it.replies|default([])|length %}
                <div class="kf-replies">
                  {% for r in it.replies %}
                    <div class="kf-reply">
                      <span class="kf-reply-who">{{ r.author }}</span>
                      <span class="kf-reply-text">{{ r.text }}</span>
                    </div>
                  {% endfor %}
                </div>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      {% endif %}

      {% if data.regular|default([])|length %}
        {# ---- 普通讨论区 ---- #}
        <div class="kf-widget-section">
          {% if data.pinned|default([])|length %}
            <div class="kf-widget-label kf-widget-label-sub">
              <i class="fas fa-comments"></i> {{ i18n.subtitle ?? '最新讨论' }}
            </div>
          {% endif %}
          {% for it in data.regular %}
            <div class="kf-row">
              <div class="kf-avatar" aria-hidden="true"
                   style="background: hsl({{ it.avatarColor }}, 58%, 56%);">
                {{ it.avatarInitial }}
              </div>
              <div class="kf-body">
                <a class="kf-row-title" href="{{ it.url }}" target="_blank"
                   rel="noopener noreferrer" title="{{ it.title }}">{{ it.title }}</a>
                <div class="kf-meta">
                  <span><i class="fas fa-user"></i>{{ it.author }}</span>
                  {# 最后回复者与发起者不同时才显示，否则纯属冗余 #}
                  {% if it.lastPoster and it.lastPoster != it.author %}
                    <span><i class="fas fa-reply"></i>{{ it.lastPoster }}</span>
                  {% endif %}
                  <span><i class="far fa-clock"></i>{{ it.lastPostedRel }}</span>
                </div>
              </div>
              <div class="kf-stat">
                <b>{{ it.comments }}</b>
                <small>{{ i18n.replies ?? '回复' }}</small>
              </div>

              {#
                评论预览：显示最近 N 条回复的正文摘要。
                ⚠️ it.replies[].text 在 PHP 侧已用 kokuu_forum_plain_text()
                   洗成纯文本（剥标签 + 反转义实体 + 压缩空白），
                   这里是 autoescape 的普通文本输出，不做 |raw。
                   绝不能改成 |raw —— 论坛是半可信的，任何注册用户
                   都能发帖，直接输出 contentHtml 等于在登录态页面开 XSS。
              #}
              {% if it.replies|default([])|length %}
                <div class="kf-replies">
                  {% for r in it.replies %}
                    <div class="kf-reply">
                      <span class="kf-reply-who">{{ r.author }}</span>
                      <span class="kf-reply-text">{{ r.text }}</span>
                    </div>
                  {% endfor %}
                </div>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      {% endif %}

    {% else %}

      {# ---------- 空态 / 失败态 ---------- #}
      {# items 为空有两种含义：论坛真的没帖子(data.ok=true)，
         或论坛拉不到(data.ok=false)。文案与操作按钮必须区分，
         否则用户会以为是站点坏了。 #}
      <div class="kf-state">
        <i class="fas {{ data.ok|default(false) ? 'fa-comments' : 'fa-plug' }}"></i>
        <div class="kf-state-title">
          {{ data.ok|default(false)
              ? (i18n.empty ?? '论坛还没有帖子')
              : (i18n.unreachable ?? '暂时无法获取论坛内容') }}
        </div>
        <div class="kf-state-msg">
          {% if data.ok|default(false) %}
            {{ i18n.empty_hint ?? '成为第一个发帖的人吧。' }}
          {% else %}
            {{ data.message ?? i18n.unreachable_hint ?? '' }}
            <br><code class="kf-code">{{ cfg.forum_url ?? '' }}</code>
          {% endif %}
        </div>
        {# 论坛空是正常状态 → 引导发帖；拉不到才是故障 → 给重试 #}
        {% if data.ok|default(false) %}
          <a class="kf-widget-btn kf-widget-btn-primary"
             href="{{ cfg.forum_url ?? '#' }}/new" target="_blank" rel="noopener noreferrer">
            <i class="fas fa-pen-nib"></i> {{ i18n.new_post ?? '发新帖' }}
          </a>
        {% else %}
          <button type="button" class="kf-widget-btn kf-widget-btn-primary" id="kf-widget-retry">
            <i class="fas fa-rotate-right"></i> {{ i18n.retry ?? '重试' }}
          </button>
        {% endif %}
      </div>

    {% endif %}

  </div>

  {#i18n 以 JSON 块内联：widget.js 读它的 textContent 拿文案。
     用 <script type="application/json"> 而不是可执行 script，
     因为 include 出来的片段若经innerHTML 注入，脚本不会执行。 #}
  <script type="application/json" id="kf-widget-i18n">{{ i18n|json_encode|raw }}</script>
</div>