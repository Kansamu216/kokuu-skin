{#
  MC 风格抽卡页 —— plugin/kokuu-lottery

  ══════════════════════════════════════════════════════════════════
  2026-11-03 v3 重做（用户要求）
  ══════════════════════════════════════════════════════════════════
  用户原话：「我想做成米哈游二次元游戏抽卡那种界面」「因为我们是 mc，
  可以改成 mc 风格的立绘和背景」

  设计参照：原神祈愿界面
    · 顶部：金粒 / 钻石 / 绿宝石 货币栏
    · 中部：大卡池立绘（MC 场景图 + 方块装饰）
    · 底部：祈愿1次 / 祈愿10次 两个按钮
    · 抽卡动画：立绘拉开 → 光爆 → 逐张翻牌揭晓

  MC 化处理（不是照抄原神）：
    · 背景用真实 MC 场景图（矿洞/下界/末地/雪原/森林/村庄）
    · 边框、按钮、卡片一律硬边方块，2px 描边（MC GUI 质感）
    · 字体用等宽/像素风字重
    · 品质用 MC 物品配色：金粒=金、钻石=青、绿宝石=绿
    · 装饰元素是像素方块而非星芒

  ⚠️ twigbridge 限制：无 max/min 过滤器；只有 3 个 block；
     不要写 <h2>（base 已用 title 渲染 h1）
#}

{% extends 'user.base.twig' %}

{% block title %}祈愿{% endblock %}

{% block content %}
{% set d = lottery %}

<div class="mc-lot" id="mc-lot" data-url="{{ d.drawUrl }}">

  {# ============ 顶部货币栏 ============ #}
  <div class="mc-bar">
    <div class="mc-bar-left">
      <span class="mc-bar-title">祈愿</span>
    </div>
    <div class="mc-bar-right">
      <span class="mc-cur" title="金粒">
        <i class="mc-ico mc-ico--gold"></i>
        <b id="mc-gold">{{ d.spendable }}</b>
      </span>
      <span class="mc-cur" title="钻石">
        <i class="mc-ico mc-ico--diamond"></i>
        <b id="mc-diamond">{{ d.diamond }}</b>
      </span>
      <span class="mc-cur" title="绿宝石">
        <i class="mc-ico mc-ico--emerald"></i>
        <b id="mc-emerald">{{ d.emerald }}</b>
      </span>
    </div>
  </div>

  {# ============ 卡池主视觉 ============ #}
  <div class="mc-pool" id="mc-pool">
    <div class="mc-pool-scene" id="mc-scene"></div>
    <div class="mc-pool-shade"></div>

    <div class="mc-pool-inner">
      <div class="mc-pool-tag">限定祈愿</div>
      <h1 class="mc-pool-name">像素秘藏</h1>
      <p class="mc-pool-desc">
        消耗金粒祈愿，可得金粒、钻石与绿宝石
      </p>

      {# 保底进度 ============ #}
      <div class="mc-pity">
        <div class="mc-pity-item">
          <span class="mc-pity-label">距稀有保底</span>
          <div class="mc-pity-bar">
            <div class="mc-pity-fill mc-pity-fill--purple"
                 style="width: {{ d.pityPurple > 0 ? (d.sincePurple / d.pityPurple * 100) : 0 }}%"></div>
          </div>
          <span class="mc-pity-num">{{ d.pityPurple - d.sincePurple }} 抽</span>
        </div>
        <div class="mc-pity-item">
          <span class="mc-pity-label">距传说保底</span>
          <div class="mc-pity-bar">
            <div class="mc-pity-fill mc-pity-fill--gold"
                 style="width: {{ d.pityGold > 0 ? (d.sinceGold / d.pityGold * 100) : 0 }}%"></div>
          </div>
          <span class="mc-pity-num">{{ d.pityGold - d.sinceGold }} 抽</span>
        </div>
      </div>
    </div>

    {# 三个品质的示例方块 + 标签 ============ #}
    <div class="mc-pool-rarities">
      <div class="mc-rarity mc-rarity--gold">
        <i class="mc-ico mc-ico--emerald"></i>
        <span>绿宝石</span>
      </div>
      <div class="mc-rarity mc-rarity--purple">
        <i class="mc-ico mc-ico--diamond"></i>
        <span>钻石</span>
      </div>
      <div class="mc-rarity mc-rarity--blue">
        <i class="mc-ico mc-ico--gold"></i>
        <span>金粒</span>
      </div>
    </div>
  </div>

  {# ============ 底部操作区 ============ #}
  <div class="mc-actions">
    <button type="button" class="mc-btn mc-btn--one" id="mc-draw1"
            {% if not d.canDraw %}disabled{% endif %}>
      <span class="mc-btn-main">祈愿 1 次</span>
      <span class="mc-btn-cost">
        <i class="mc-ico mc-ico--gold"></i>{{ d.cost }}
      </span>
    </button>

    <button type="button" class="mc-btn mc-btn--ten" id="mc-draw10"
            {% if not d.canTen %}disabled{% endif %}>
      <span class="mc-btn-main">祈愿 10 次</span>
      <span class="mc-btn-cost">
        <i class="mc-ico mc-ico--gold"></i>{{ d.cost * 10 }}
      </span>
    </button>
  </div>

  <p class="mc-hint" id="mc-hint">
    {% if not d.canDraw %}
      金粒不足，无法祈愿
    {% else %}
      每 {{ d.pityPurple }} 抽必得稀有，每 {{ d.pityGold }} 抽必得传说
    {% endif %}
  </p>

  {# ============ 结果区（单抽/十连共用）============ #}
  <div class="mc-result" id="mc-result" role="status" aria-live="polite" hidden></div>

  {# ============ 最近祈愿 ============ #}
  <section class="mc-history">
    <header class="mc-history-head">
      <span>最近祈愿</span>
      {% if myDraws is not empty %}
        <span class="mc-history-count">共 {{ myDraws|length }} 条</span>
      {% endif %}
    </header>
    {% if myDraws is not empty %}
      <ul class="mc-history-list">
        {% for r in myDraws|slice(0, 12) %}
          <li class="mc-history-item mc-history-item--{{ r.rarity }}">
            <span class="mc-history-dot"></span>
            <span class="mc-history-label">{{ r.prize_label }}</span>
            <span class="mc-history-time">{{ r.created_at|slice(5, 11) }}</span>
          </li>
        {% endfor %}
      </ul>
    {% else %}
      <div class="mc-history-empty">还没有祈愿记录</div>
    {% endif %}
  </section>
</div>
{% endblock %}

{% block before_foot %}
<link rel="stylesheet" href="{{ url('/plugins/kokuu-lottery/assets/lottery.css') }}?v=3.0.0">

{#
  ══════════════════════════════════════════════════════════════════
  🎬 抽卡动画层
  ══════════════════════════════════════════════════════════════════
  原神式流程：
    1. 全屏暗场 + 卡池立绘放大
    2. 光爆（白色闪屏 + 光条炸开）
    3. 逐张翻牌：单抽翻 1 张，十连逐张翻 10 张
    4. 金/紫卡有专属光效
  ⚠️ 总时长必须与 lottery.js 的 ANIM 常量对齐
  ⚠️ 默认 hidden，只有 .is-on 才显示，否则永久挡住点击
  ══════════════════════════════════════════════════════════════════
#}
<div class="mc-anim" id="mc-anim" hidden aria-hidden="true">
  <div class="mc-anim-dark"></div>
  <div class="mc-anim-flash"></div>
  <div class="mc-anim-rays">
    <i></i><i></i><i></i><i></i><i></i><i></i>
  </div>

  <div class="mc-cards" id="mc-cards"></div>

  <button type="button" class="mc-anim-skip" id="mc-skip">跳 过</button>
</div>

<script>
  window.MC_CSRF = (function () {
    var m = document.cookie.match(/(?:^|;\s*)XSRF-TOKEN=([^;]+)/);
    return m ? decodeURIComponent(m[1]) : '';
  })();
</script>
<script src="{{ url('/plugins/kokuu-lottery/assets/lottery.js') }}?v=3.0.0"></script>
{% endblock %}

